rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // true only for signed-in users with the admin custom claim
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // pins on map, anyone can read, only admins can change them
    match /pins/{pinId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // unique visitor counter, one doc per anonymous user
    match /visitors/{uid} {
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['firstSeen'])
                    && request.resource.data.firstSeen == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}

// a get on /pins/test with no auth should be allowed
// a create on /pins/test with no auth should be denied. Try it again with an authenticated user and no admin claim, and it should still be denied
// a create on /visitors/abc123 with a signed-in user whose UID is abc123 should work only if the data is exactly { firstSeen: <timestamp> }